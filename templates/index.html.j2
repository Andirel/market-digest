<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Consensus &middot; {{ date }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12100d; --panel:#1a1713; --ink:#f3ece0; --muted:#9a9082;
    --line:#2c271f; --buy:#7ec88a; --sell:#e08762; --hold:#cdbf8a; --accent:#e8a13c;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:"Spline Sans Mono",ui-monospace,monospace;font-size:14px;line-height:1.5;
    background-image:radial-gradient(circle at 15% -10%,rgba(232,161,60,.08),transparent 40%);}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px 80px}
  header{padding:56px 0 32px;border-bottom:1px solid var(--line)}
  .kicker{color:var(--accent);letter-spacing:.32em;text-transform:uppercase;font-size:11px}
  h1{font-family:"Fraunces",Georgia,serif;font-weight:900;font-size:clamp(40px,7vw,76px);
    line-height:.95;margin:.18em 0 .1em;letter-spacing:-.02em}
  .dateline{color:var(--muted)}
  .stats{display:flex;flex-wrap:wrap;gap:28px;margin-top:28px}
  .stat .n{font-family:"Fraunces",serif;font-size:30px;font-weight:600}
  .stat .l{color:var(--muted);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
  section{padding-top:48px}
  h2{font-family:"Fraunces",serif;font-weight:600;font-size:26px;margin:0 0 4px}
  .sub{color:var(--muted);margin:0 0 20px}
  .controls{display:flex;gap:12px;margin:18px 0}
  input[type=search]{flex:1;background:var(--panel);border:1px solid var(--line);
    color:var(--ink);padding:11px 14px;border-radius:8px;font:inherit}
  input::placeholder{color:var(--muted)}
  table{width:100%;border-collapse:collapse}
  th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line)}
  th{color:var(--muted);font-size:11px;letter-spacing:.1em;text-transform:uppercase;
    cursor:pointer;user-select:none;position:sticky;top:0;background:var(--bg)}
  th:hover{color:var(--ink)}
  tbody tr:hover{background:var(--panel)}
  .sym{font-weight:600}
  .name{color:var(--muted);max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:12px;border:1px solid}
  .b1{color:var(--buy);border-color:var(--buy)}
  .b2{color:#bcd9a0;border-color:#bcd9a0}
  .b3{color:var(--hold);border-color:var(--hold)}
  .b4,.b5{color:var(--sell);border-color:var(--sell)}
  .num{font-variant-numeric:tabular-nums}
  .lens-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:22px 24px;margin-bottom:18px}
  .lens-head{display:flex;align-items:baseline;gap:14px;margin-bottom:14px}
  .lens-head .t{font-family:"Fraunces",serif;font-size:22px;font-weight:600}
  .lens-grid{display:grid;grid-template-columns:1fr;gap:16px}
  .lens{border-left:2px solid var(--accent);padding-left:14px}
  .lens .fw{color:var(--accent);font-weight:600;margin-bottom:6px}
  .horizon{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.1em}
  .disclaimer{margin-top:56px;padding:20px;border:1px dashed var(--line);border-radius:10px;
    color:var(--muted);font-size:12px;line-height:1.6}
  footer{margin-top:40px;color:var(--muted);font-size:12px;border-top:1px solid var(--line);padding-top:20px}
  @media(min-width:720px){.lens-grid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="kicker">NASDAQ &amp; NYSE &middot; Analyst Consensus Digest</div>
    <h1>The Consensus</h1>
    <div class="dateline">Updated {{ date }} &middot; ratings on a 1 (Strong Buy) &ndash; 5 (Strong Sell) scale</div>
    <div class="stats">
      <div class="stat"><div class="n num">{{ stats.total }}</div><div class="l">Symbols tracked</div></div>
      <div class="stat"><div class="n num">{{ stats.covered }}</div><div class="l">With coverage</div></div>
      <div class="stat"><div class="n num" style="color:var(--buy)">{{ stats.strong_buy }}</div><div class="l">Strong Buy</div></div>
      <div class="stat"><div class="n num" style="color:var(--buy)">{{ stats.buy }}</div><div class="l">Buy</div></div>
    </div>
  </header>

  {% if perspectives %}
  <section>
    <h2>Five lenses on the watchlist</h2>
    <p class="sub">Each name read through five investing frameworks &mdash; analytical schools of thought, not the views of any individual.</p>
    {% for sym, lenses in perspectives.items() %}
      {% if lenses %}
      <div class="lens-card">
        <div class="lens-head"><span class="t">{{ sym }}</span></div>
        <div class="lens-grid">
          {% for L in lenses %}
          <div class="lens">
            <div class="fw">{{ L.framework }}</div>
            <div><span class="horizon">Short&nbsp;term</span><br>{{ L.short_term }}</div>
            <div style="margin-top:8px"><span class="horizon">Long&nbsp;term</span><br>{{ L.long_term }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </section>
  {% endif %}

  <section>
    <h2>Full consensus table</h2>
    <p class="sub">Lower score = more bullish. Click a header to sort; type to filter.</p>
    <div class="controls">
      <input id="q" type="search" placeholder="Filter by symbol or company&hellip;">
    </div>
    <table id="tbl">
      <thead><tr>
        <th data-k="symbol">Symbol</th>
        <th data-k="name">Company</th>
        <th data-k="exchange">Exchange</th>
        <th data-k="mean" data-num="1">Score</th>
        <th data-k="label">Consensus</th>
        <th data-k="analysts" data-num="1"># Analysts</th>
      </tr></thead>
      <tbody>
      {% for r in ratings %}
        <tr>
          <td class="sym">{{ r.symbol }}</td>
          <td class="name">{{ r.name }}</td>
          <td>{{ r.exchange }}</td>
          <td class="num">{{ "%.2f"|format(r.mean) if r.mean is not none else "&mdash;"|safe }}</td>
          <td><span class="pill b{{ (r.mean|round(0,'common')|int) if r.mean is not none else 3 }}">{{ r.label }}</span></td>
          <td class="num">{{ r.analysts }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <div class="disclaimer">
    <strong>Not investment advice.</strong> This page aggregates third-party analyst
    ratings and presents general, impersonal commentary generated by an AI model
    through named investing frameworks. It is for information and education only,
    is not personalized to anyone&rsquo;s situation, and is not a recommendation to buy
    or sell any security. The framework commentary does not represent the views of
    any real person. Data may be delayed or inaccurate. Do your own research and
    consult a licensed professional.
  </div>

  <footer>The Consensus &middot; generated {{ date }} &middot; data via third-party sources</footer>
</div>

<script>
  // search
  const q = document.getElementById('q'), rows = [...document.querySelectorAll('#tbl tbody tr')];
  q.addEventListener('input', () => {
    const v = q.value.toLowerCase();
    rows.forEach(r => { r.style.display = r.textContent.toLowerCase().includes(v) ? '' : 'none'; });
  });
  // sort
  let dir = 1;
  document.querySelectorAll('#tbl th').forEach((th, i) => th.addEventListener('click', () => {
    const num = th.dataset.num, body = document.querySelector('#tbl tbody');
    dir = -dir;
    [...body.querySelectorAll('tr')].sort((a, b) => {
      let x = a.children[i].textContent.trim(), y = b.children[i].textContent.trim();
      if (num) { x = parseFloat(x) || 1e9; y = parseFloat(y) || 1e9; return (x - y) * dir; }
      return x.localeCompare(y) * dir;
    }).forEach(r => body.appendChild(r));
  }));
</script>
</body>
</html>
